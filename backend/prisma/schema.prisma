generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  searches      Search[]
  // billing: mirrored from Stripe by the webhook; "free" | "pro"
  plan                 String    @default("free")
  planInterval         String?
  planExpiresAt        DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  shareLinks    ShareLink[]
  savedRanges   SavedRange[]
  savedSolves   SavedSolve[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Search {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  players     Json
  board       Json
  odds        Json
  playerNames Json?
  scenario    String?  @db.Text
  favorite    Boolean  @default(false)
  isReplay    Boolean  @default(false)
  replay      Json?
  createdAt   DateTime @default(now())
  lastAccessedAt DateTime @default(now())
  name        String?
  handId      String?
  @@unique([userId, handId])
  @@index([userId, createdAt])
  @@index([userId, favorite, lastAccessedAt])
}

// pro short links; payload uses the #s= / #r= encoding
model ShareLink {
  id          String   @id @default(cuid())
  code        String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  payload     String   @db.Text
  payloadHash String
  name        String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  @@index([userId, payloadHash])
}

model SavedRange {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keys      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

// a solver spot (board, sides, bet tree) plus a small summary; the solve re-runs on open
model SavedSolve {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  config    Json
  summary   Json
  createdAt DateTime @default(now())
  @@index([userId])
}
